@model List<Bookstore.Module.Catalog.Models.Category>



@{

    ViewData["Title"] = "Categories";

}



<div class="container page-container">

    <div class="page-header">

        <div>

            <h1 class="page-title">Categories</h1>

            <p class="page-subtitle">Organize books into categories.</p>

        </div>

        <div class="page-actions">

            <a asp-area="Catalog" asp-controller="Categories" asp-action="Create" class="btn btn-primary">

                <i class="bi bi-plus-lg me-1"></i> Create Category

            </a>

        </div>

    </div>



    <div class="content-card">

        <div class="table-responsive">

            <table class="table table-app">

                <thead>

                    <tr>

                        <th>Name</th>

                        <th>Status</th>

                        <th style="width: 180px;">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())

                    {

                        @foreach (var category in Model)

                        {

                            <tr>

                                <td class="fw-semibold">@category.Name</td>

                                <td>

                                    @if (category.IsActive)

                                    {

                                        <span class="badge rounded-pill badge-status-active">Active</span>

                                    }

                                    else

                                    {

                                        <span class="badge rounded-pill badge-status-inactive">Inactive</span>

                                    }

                                </td>

                                <td>

                                    <div class="table-actions">

                                        <a asp-area="Catalog" asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id"

                                           class="btn btn-sm btn-outline-primary" title="Edit">

                                            <i class="bi bi-pencil"></i>

                                        </a>



                                        @if (category.IsActive)

                                        {

                                            <form asp-area="Catalog" asp-controller="Categories" asp-action="Deactivate"

                                                  asp-route-id="@category.Id" method="post" class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Deactivate"

                                                        onclick="return confirm('Are you sure you want to deactivate this category?');">

                                                    <i class="bi bi-slash-circle"></i>

                                                </button>

                                            </form>

                                        }

                                    </div>

                                </td>

                            </tr>

                        }

                    }

                    else

                    {

                        <tr class="table-empty">

                            <td colspan="3">

                                <i class="bi bi-tags d-block fs-3 mb-2 text-muted"></i>

                                No categories yet. Create your first category to get started.

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

