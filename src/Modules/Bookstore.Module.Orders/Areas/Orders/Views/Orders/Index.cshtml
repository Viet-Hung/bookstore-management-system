@model List<Bookstore.Module.Orders.Models.Order>

@using Bookstore.Module.Orders.Models



@{

    ViewData["Title"] = "Orders";

}



<div class="container page-container">

    <div class="page-header">

        <div>

            <h1 class="page-title">Orders</h1>

            <p class="page-subtitle">View and manage customer orders.</p>

        </div>

        <div class="page-actions">

            <a asp-area="Orders" asp-controller="Orders" asp-action="Create" class="btn btn-primary">

                <i class="bi bi-plus-lg me-1"></i> Create Order

            </a>

        </div>

    </div>



    <div class="content-card">

        <div class="table-responsive">

            <table class="table table-app">

                <thead>

                    <tr>

                        <th>#</th>

                        <th>Order Date</th>

                        <th>Status</th>

                        <th>Total</th>

                        <th style="width: 200px;">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())

                    {

                        @foreach (var order in Model)

                        {

                            <tr>

                                <td><span class="text-muted">#@order.Id</span></td>

                                <td>@order.OrderDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>

                                <td>

                                    @switch (order.Status)

                                    {

                                        case OrderStatus.Pending:

                                            <span class="badge rounded-pill badge-order-pending">Pending</span>

                                            break;

                                        case OrderStatus.Completed:

                                            <span class="badge rounded-pill badge-order-completed">Completed</span>

                                            break;

                                        case OrderStatus.Cancelled:

                                            <span class="badge rounded-pill badge-order-cancelled">Cancelled</span>

                                            break;

                                        default:

                                            <span class="badge rounded-pill bg-secondary">@order.Status</span>

                                            break;

                                    }

                                </td>

                                <td class="fw-semibold">@order.TotalAmount.ToString("C")</td>

                                <td>

                                    <div class="table-actions">

                                        <a asp-area="Orders" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"

                                           class="btn btn-sm btn-outline-primary" title="Details">

                                            <i class="bi bi-eye"></i>

                                        </a>



                                        @if (order.Status != OrderStatus.Cancelled)

                                        {

                                            <form asp-area="Orders" asp-controller="Orders" asp-action="Cancel" asp-route-id="@order.Id"

                                                  method="post" class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancel order"

                                                        onclick="return confirm('Are you sure you want to cancel this order?');">

                                                    <i class="bi bi-x-circle"></i>

                                                </button>

                                            </form>

                                        }

                                    </div>

                                </td>

                            </tr>

                        }

                    }

                    else

                    {

                        <tr class="table-empty">

                            <td colspan="5">

                                <i class="bi bi-cart d-block fs-3 mb-2 text-muted"></i>

                                No orders yet. Create your first order to get started.

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

