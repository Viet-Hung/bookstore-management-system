@model Bookstore.Module.Catalog.ViewModels.CreateCategoryViewModel



@{

    ViewData["Title"] = "Create Category";

}



<div class="container page-container">

    <div class="page-header">

        <div>

            <h1 class="page-title">Create Category</h1>

            <p class="page-subtitle">Add a new category for your books.</p>

        </div>

        <div class="page-actions">

            <a asp-area="Catalog" asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i> Back

            </a>

        </div>

    </div>



    <div class="form-panel">

        <form asp-area="Catalog" asp-controller="Categories" asp-action="Create" method="post">

            @Html.AntiForgeryToken()



            <div class="mb-0">

                <label asp-for="Name" class="form-label"></label>

                <input asp-for="Name" class="form-control" placeholder="e.g. Fiction, Science" />

                <span asp-validation-for="Name" class="text-danger small"></span>

            </div>



            <div class="form-actions">

                <button type="submit" class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i> Create

                </button>

                <a asp-area="Catalog" asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>

            </div>

        </form>

    </div>

</div>



@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

