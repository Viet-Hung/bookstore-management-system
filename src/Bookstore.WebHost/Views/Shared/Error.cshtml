@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container page-container">
    <div class="error-page content-card p-4 p-md-5">
        <i class="bi bi-exclamation-octagon error-icon"></i>
        <h1>Something went wrong</h1>
        <p class="text-muted">An error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <p class="mt-3">
                <span class="text-muted">Request ID:</span>
                <code class="user-select-all">@Model.RequestId</code>
            </p>
        }

        <div class="dev-note mx-auto" style="max-width: 640px;">
            <h3 class="h6 fw-bold mb-2"><i class="bi bi-info-circle me-1"></i> Development Mode</h3>
            <p class="mb-2">
                Swapping to <strong>Development</strong> environment will display more detailed information about the error.
            </p>
            <p class="mb-0 small text-muted">
                The Development environment should not be enabled in production. For local debugging, set
                <strong>ASPNETCORE_ENVIRONMENT</strong> to <strong>Development</strong> and restart the app.
            </p>
        </div>
    </div>
</div>
