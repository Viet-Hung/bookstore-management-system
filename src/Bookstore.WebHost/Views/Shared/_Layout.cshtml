@{

    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

}



<!DOCTYPE html>

<html lang="en">



<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Bookstore</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>



<body>

    <header>

        <nav class="navbar navbar-expand-sm app-navbar">

            <div class="container">

                <a class="navbar-brand" asp-area="Core" asp-controller="Home" asp-action="Index">

                    <i class="bi bi-book-half"></i>

                    Bookstore

                </a>



                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"

                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>



                <div class="navbar-collapse collapse" id="mainNav">

                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">

                            <a class="nav-link @(currentArea == "Core" && currentController == "Home" ? "active" : "")"

                               asp-area="Core" asp-controller="Home" asp-action="Index">

                                <i class="bi bi-house-door me-1"></i> Home

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @(currentArea == "Core" && currentController == "Dashboard" ? "active" : "")"

                               asp-area="Core" asp-controller="Dashboard" asp-action="Index">

                                <i class="bi bi-grid-1x2 me-1"></i> Dashboard

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @(currentArea == "Catalog" && currentController == "Books" ? "active" : "")"

                               asp-area="Catalog" asp-controller="Books" asp-action="Index">

                                <i class="bi bi-journal-text me-1"></i> Books

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @(currentArea == "Catalog" && currentController == "Categories" ? "active" : "")"

                               asp-area="Catalog" asp-controller="Categories" asp-action="Index">

                                <i class="bi bi-tags me-1"></i> Categories

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @(currentArea == "Orders" && currentController == "Orders" ? "active" : "")"

                               asp-area="Orders" asp-controller="Orders" asp-action="Index">

                                <i class="bi bi-cart3 me-1"></i> Orders

                            </a>

                        </li>

                        <li class="nav-item">

                            <span class="nav-link disabled-muted">

                                <i class="bi bi-people me-1"></i> Users

                            </span>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>



    <main role="main">

        <partial name="_AlertMessages" />

        @RenderBody()

    </main>



    <footer class="app-footer">

        <div class="container text-center">

            &copy; 2026 Bookstore Management System

        </div>

    </footer>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>



</html>

