@model Bookstore.Module.Catalog.ViewModels.EditCategoryViewModel



@{

    ViewData["Title"] = "Edit Category";

}



<div class="container page-container">

    <div class="page-header">

        <div>

            <h1 class="page-title">Edit Category</h1>

            <p class="page-subtitle">Update category <strong>@Model.Name</strong>.</p>

        </div>

        <div class="page-actions">

            <a asp-area="Catalog" asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i> Back

            </a>

        </div>

    </div>



    <div class="form-panel">

        <form asp-area="Catalog" asp-controller="Categories" asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />



            <div class="mb-3">

                <label asp-for="Name" class="form-label"></label>

                <input asp-for="Name" class="form-control" />

                <span asp-validation-for="Name" class="text-danger small"></span>

            </div>



            <div class="form-check mb-0">

                <input asp-for="IsActive" class="form-check-input" />

                <label asp-for="IsActive" class="form-check-label"></label>

            </div>



            <div class="form-actions">

                <button type="submit" class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i> Save

                </button>

                <a asp-area="Catalog" asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>

            </div>

        </form>

    </div>

</div>



@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

