@{

    ViewData["Title"] = "Dashboard";

    Layout = "~/Views/Shared/_Layout.cshtml";

}



<div class="container page-container">

    <div class="page-header">

        <div>

            <h1 class="page-title">Dashboard</h1>

            <p class="page-subtitle">Overview and quick links to manage your bookstore.</p>

        </div>

    </div>



    <div class="row g-4">

        <div class="col-md-4">

            <div class="dash-card">

                <div class="dash-icon catalog">

                    <i class="bi bi-journal-text"></i>

                </div>

                <h5>Catalog</h5>

                <p>Manage books, categories, pricing, and inventory levels.</p>

                <a asp-area="Catalog" asp-controller="Books" asp-action="Index" class="btn btn-primary">

                    <i class="bi bi-arrow-right me-1"></i> Open Catalog

                </a>

            </div>

        </div>



        <div class="col-md-4">

            <div class="dash-card">

                <div class="dash-icon orders">

                    <i class="bi bi-cart3"></i>

                </div>

                <h5>Orders</h5>

                <p>Track and process customer orders from creation to completion.</p>

                <a asp-area="Orders" asp-controller="Orders" asp-action="Index" class="btn btn-primary">

                    <i class="bi bi-arrow-right me-1"></i> View Orders

                </a>

            </div>

        </div>



        <div class="col-md-4">

            <div class="dash-card">

                <div class="dash-icon users">

                    <i class="bi bi-people"></i>

                </div>

                <h5>Users</h5>

                <p>Manage accounts, roles, and access control. Coming soon.</p>

                <button type="button" class="btn btn-secondary" disabled>

                    Coming soon

                </button>

            </div>

        </div>

    </div>

</div>

